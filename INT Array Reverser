#include <stdio.h>

int main(){
    int arr[5]={1,2,3,4,5};
    int size=sizeof(arr)/sizeof(arr[0]);
    int reversed[5];
    
    for(int c=0; c<size; c++){
    printf("Original Array: %d\n", arr[c]);
    }
    
    for(int i=0; i<size; i++){
        reversed[i]=arr[size-i-1];
    }
    for(int j=0; j<size; j++){
    printf("Reversed Array: %d\n", reversed[j]);
    }
    }