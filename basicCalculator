//Basic calculator in C

#include <stdio.h>

int main()
{
    int num1, num2;
    double result;
    char op;
    printf("Enter a number: ");
    scanf("%d", &num1);
    getchar();
    printf("enter an operator (+,-,*,/): ");
    scanf("%c", &op);
    printf("enter another number: ");
    scanf("%d", &num2);

    switch (op)
    {
    case '+':
        result = num1 + num2;
        break;

    case '-':
        result = num1 - num2;
        break;

    case '*':
        result = num1 * num2;
        break;

    case '/':
        if (num2 >= 1)
        {
            result = num1 / num2;
        }
        else
        {
            printf("Error!\n");
            return 1;
        }
        break;

    default:
        printf("Invalid operator!");
    }
    printf("result: %.1lf", result);
}
