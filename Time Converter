#include <stdio.h>

void hourToMin(){
    int hour;
    printf("Enter time in hours: ");
    scanf("%d", &hour);
    
    printf("%dh is %dm", hour, hour*60);
}

void minToSec(){
    int min;
    printf("Enter time in minutes: ");
    scanf("%d", &min);
    
    printf("%dm is %ds", min, min*60);
}

int main()
{
	int userChoice;
	int loop;
	
	do {
	printf("1. Hours to Minutes.\n");
	printf("2. Minutes to Seconds.\n");
	
	printf("Go to(1-2): ");
	scanf("%d", &userChoice);
	
	switch(userChoice){
	    case 1: 
	    hourToMin();
	    break;
	    case 2:
	    minToSec();
	    break;
	    default:
	    printf("Invalid!\n");
	    break;
	}
	printf("\nBack to menu(1=yes): ");
	scanf("%d", &loop);
	}while(loop==1);
	return 0;
}